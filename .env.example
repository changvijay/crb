# ONE env file for the whole app. Copy to .env.local and fill in.
# (BACKEND_URL is set automatically by server.mjs; do not add it.)

# ── Site ────────────────────────────────────────────────
# Public origin of this app (same-origin checks, Auth0 return URL)
SITE_ORIGIN=http://localhost:3000
SITE_URL=http://localhost:3000
# PORT=3000          # public port (optional)
# BACKEND_PORT=8080  # internal Express port, loopback only (optional)

# ── Database ────────────────────────────────────────────
MONGODB_URI=

# ── Auth0 ───────────────────────────────────────────────
# Tenant host, e.g. your-tenant.auth0.com
AUTH0_DOMAIN=
AUTH0_CLIENT_ID=
AUTH0_SECRET=
# AUTH0_BASE_URL defaults to SITE_ORIGIN

# ── App auth ────────────────────────────────────────────
JWT_SECRET=
ADMIN_PASSWORD=

# ── AI / news ───────────────────────────────────────────
AI_PROVIDER=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=
NEWS_API_KEY=

# ── Email ───────────────────────────────────────────────
GMAIL_USER=
GMAIL_APP_PASSWORD=
