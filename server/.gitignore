# ════════════════════════════════════════════════════════════════════════════════
#  .gitignore — Chang Market Report
#  Stack: Node.js · Express · MongoDB · Auth0 · Vanilla HTML/CSS/JS · k6
# ════════════════════════════════════════════════════════════════════════════════


# ──────────────────────────────────────────────────────────────────────────────
# ENVIRONMENT & SECRETS
# Never commit credentials, API keys, or environment-specific config.
# ──────────────────────────────────────────────────────────────────────────────
.env
.env.*
!.env.example          # allow a documented template to be committed
.env.local
.env.development
.env.staging
.env.production
.env.test
*.pem
*.key
*.p12
*.pfx
*.crt
*.cert
secrets/
config/secrets.*


# ──────────────────────────────────────────────────────────────────────────────
# NODE.JS / NPM / YARN / PNPM
# ──────────────────────────────────────────────────────────────────────────────
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
.pnpm-store/
.npm/
.yarn/
!.yarn/releases
!.yarn/plugins
package-lock.json       # uncomment to commit the lockfile (recommended for apps)
yarn.lock               # uncomment to commit the lockfile


# ──────────────────────────────────────────────────────────────────────────────
# BUILD & DISTRIBUTION OUTPUT
# ──────────────────────────────────────────────────────────────────────────────
dist/
build/
out/
.cache/
.parcel-cache/
.next/
.nuxt/
.svelte-kit/


# ──────────────────────────────────────────────────────────────────────────────
# LOGS & DIAGNOSTIC FILES
# ──────────────────────────────────────────────────────────────────────────────
logs/
*.log
*.log.*
*.log-*
crash.log
server.log
error.log
access.log
combined.log


# ──────────────────────────────────────────────────────────────────────────────
# TEMPORARY & GENERATED DATA
# BhavCopy JSON files are auto-synced at runtime — do not commit raw data.
# ──────────────────────────────────────────────────────────────────────────────
temp/
tmp/
*.tmp
*.bak
*.swp
*.swo
summary.json            # generated at runtime


# ──────────────────────────────────────────────────────────────────────────────
# LOAD TESTING
# k6 binaries and result artifacts should not be tracked.
# ──────────────────────────────────────────────────────────────────────────────
k6-v*/                  # e.g. k6-v0.54.0-macos-amd64/
*.k6
load-test-results/
k6-results/
summary-*.json


# ──────────────────────────────────────────────────────────────────────────────
# OPERATING SYSTEM FILES
# ──────────────────────────────────────────────────────────────────────────────

# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
.AppleDouble
.LSOverride
Icon?
ehthumbs.db

# Windows
Thumbs.db
Thumbs.db:encryptable
desktop.ini
$RECYCLE.BIN/
*.lnk

# Linux
*~
.fuse_hidden*
.Trash-*
.nfs*


# ──────────────────────────────────────────────────────────────────────────────
# IDE & EDITOR FILES
# ──────────────────────────────────────────────────────────────────────────────

# VS Code — keep shared launch/task configs if the team uses them
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json
!.vscode/tasks.json

# JetBrains (WebStorm, IntelliJ, etc.)
.idea/
*.iml
*.ipr
*.iws
.idea_modules/

# Vim / Neovim
*.swp
*.swo
Session.vim
.netrwhist
tags

# Emacs
*~
\#*\#
/.emacs.desktop
/.emacs.desktop.lock
*.elc
auto-save-list
tramp

# Sublime Text
*.sublime-project
*.sublime-workspace

# TextMate
*.tmproj
*.tmproject
.tmignore


# ──────────────────────────────────────────────────────────────────────────────
# TESTING & COVERAGE
# ──────────────────────────────────────────────────────────────────────────────
coverage/
.nyc_output/
*.lcov
test-results/
junit.xml
*.snap


# ──────────────────────────────────────────────────────────────────────────────
# RUNTIME & PROCESS FILES
# ──────────────────────────────────────────────────────────────────────────────
*.pid
*.seed
*.pid.lock
pids/
.node_repl_history


# ──────────────────────────────────────────────────────────────────────────────
# MISCELLANEOUS
# ──────────────────────────────────────────────────────────────────────────────
*.tgz
*.gz
*.zip
*.tar
*.rar
.eslintcache
.stylelintcache
.prettiercache
