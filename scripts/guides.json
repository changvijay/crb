      "--brand": "var(--accent)",
      "--brand-soft": "var(--accent-soft)",
      "--bull": "var(--up)",
      "--bear": "var(--down)",
      "--warn-bg": "color-mix(in srgb, var(--warn) 12%, transparent)",
      "--warn-line": "var(--warn)",
      "--serif": "var(--f-display), system-ui, sans-serif",
      "--sans": "var(--f-sans), system-ui, sans-serif"
