    "extra_css": ".g-price-action .takeaway{background:var(--up-soft)}\n.g-price-action .learn,.g-price-action .note{background:var(--accent-soft)}\n.g-price-action figure svg{background:var(--g-soft)}\n.g-price-action{font-size:16.5px}\n.g-price-action figure svg text{fill:var(--g-muted)!important}\n.g-price-action figure svg [stroke=\"#52606f\"],.g-price-action figure svg [stroke=\"#17202c\"]{stroke:var(--g-muted)}"
  },
